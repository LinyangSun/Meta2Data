#!/bin/bash

show_help() {
    cat << EOF
Usage: Meta2Data <command> [options]

Available commands:
    MetaDL                  Retrieve and merge metadata from ID files or keyword searches.
    AmpliconPIP             Process public reads, local FASTQ datasets, or both with dada2 or vsearch.
    AmpliconTAXA            Merge amplicon datasets (method auto-detected) and assign taxonomy (GreenGenes2 or SILVA).

Run 'Meta2Data <command> --help' for command-specific options.
EOF
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 1
fi

# Resolve symlinks before locating sibling commands or packaged scripts.
_M2D_ENTRYPOINT="$(readlink -f -- "${BASH_SOURCE[0]}")" || {
    echo "ERROR: Cannot resolve Meta2Data entry point: ${BASH_SOURCE[0]}" >&2
    exit 1
}
BIN_DIR="$(dirname -- "$_M2D_ENTRYPOINT")"

COMMAND=$1
shift
case $COMMAND in
    MetaDL)
        exec "${BIN_DIR}/Meta2Data-MetaDL" "$@"
        ;;
    AmpliconPIP)
        exec "${BIN_DIR}/Meta2Data-AmpliconPIP" "$@"
        ;;
    AmpliconTAXA)
        exec "${BIN_DIR}/Meta2Data-AmpliconTAXA" "$@"
        ;;
    -h|--help)
        show_help
        exit 0
        ;;
    *)
        echo "Error: Unknown command '$COMMAND'"
        show_help
        exit 1
        ;;
esac
