#!/bin/bash
set -e

# Resolve symlinks before locating sibling commands or packaged scripts.
_M2D_ENTRYPOINT="$(readlink -f -- "${BASH_SOURCE[0]}")" || {
    echo "ERROR: Cannot resolve Meta2Data entry point: ${BASH_SOURCE[0]}" >&2
    exit 1
}
SCRIPT_DIR="$(dirname -- "$(dirname -- "$_M2D_ENTRYPOINT")")"

# Search for scripts directory in multiple possible locations
find_scripts_dir() {
    local search_paths=(
        "${SCRIPT_DIR}/scripts"                          # Development/git repo
        "${SCRIPT_DIR}/share/Meta2Data/scripts"          # pip install --target
        "/usr/local/share/Meta2Data/scripts"             # System install
        "${HOME}/.local/share/Meta2Data/scripts"         # User install (pip install --user)
        "${CONDA_PREFIX}/share/Meta2Data/scripts"        # Conda install
        "${PREFIX}/share/Meta2Data/scripts"              # Alternative prefix
    )

    for path in "${search_paths[@]}"; do
        if [[ -d "$path" && -f "$path/AmpliconFunction.sh" ]]; then
            echo "$path"
            return 0
        fi
    done

    echo "ERROR: Scripts directory not found in any location:" >&2
    for path in "${search_paths[@]}"; do
        echo "  - $path" >&2
    done
    return 1
}

if ! SCRIPTS=$(find_scripts_dir); then
    echo "ERROR: Cannot find scripts directory"
    exit 1
fi

export M2D_PROFILE_MODULE=pip
source "${SCRIPTS}/resource_profile.sh"

show_help() {
    cat << EOF
Usage: Meta2Data AmpliconPIP [options]

Download or read amplicon data and process it with dada2 or vsearch.
Choose exactly one method: --dada2 or --vsearch (no default).

Online batch mode (primers detected separately for each dataset):
    --public-m FILE                     Metadata CSV
    --public-bioproject-colNAME NAME    BioProject column (required with a user CSV)
    --public-sra-colNAME NAME           Run column (required with a user CSV)

Selected projects with explicit primers:
    --public-bioprojectIDs ID ...       Select projects from the original CSV; off by default.
    --public-primer-fwd SEQ ...         One forward primer per selected project, same order.
    --public-primer-rev SEQ ...         Optional reverse list; if provided, one per project.
                                        Requires --public-m and both public column options. All selected
                                        projects use explicit primers; no automatic detection.
                                        No broadcasting or automatic reverse-primer filling.

Local metadata CSV (can be combined with ordinary online --public-m input):
    --local-m FILE                      CSV listing local datasets; no download for these rows.
    --local-datasets-colNAME NAME       Dataset name column (required with --local-m).
    --local-path-colNAME NAME           FASTQ directory column (required with --local-m).
    --local-platform-colNAME NAME       Platform column (required with --local-m).
    --local-primer-f-colNAME NAME       Optional forward-primer column; enables explicit primers
                                        for rows containing a sequence. Empty rows auto-detect.
    --local-primer-r-colNAME NAME       Optional reverse-primer column; requires the forward
                                        column option. A reverse value requires a forward value.
                                        Paths are relative to the local CSV or absolute.
                                        Each row has its own platform and optional primers.
                                        Mixed input cannot use --public-bioprojectIDs or --test.

Output and resources:
    Results are saved in results/pip/ in the startup working directory.
    Start independent analyses from different working directories.
    -t, --threads N                     Total threads (default: 4).
    --max-parallel N                    Concurrent datasets (default: 2). Limited by dataset
                                        count and total threads; one dataset uses all threads.
    --parameter FILE                    JSON overrides; see docs/parameters.default.json.
                                        Ion EE defaults to post-primer median read length
                                        multiplied by 10^(-19/10), for both methods.
                                        Set vsearch.ion_maxee / dada2.ion_maxee to override.
                                        454 filters each sample after primer/tail trimming:
                                        length >= ceil(0.5 * its median), then at most 1 N.
                                        Override ls454.length_fraction / ls454.max_n in JSON.
                                        Filtering precedes 99% preclustering; mapping uses
                                        filtered reads and excludes identified chimera members.
    --skip-unknown-primers              Both input types: skip entire datasets with unknown primers
                                        instead of the default 20 bp trim (no match and fold <16).

Adapter protection (enabled by default; normal adapter removal still runs when disabled):
    --adapter-guard                     Check fastp candidates against a 16S reference (default).
                                        Missing GG2 reference is prepared automatically in
                                        <working directory>/results/db/.
                                        The BLAST cache is fixed at results/db/adapter_guard/.
    --no-adapter-guard                  Disable the additional check.

Tests and help:
    --test                              Online input only; cannot combine with --local-m.
                                        Without --public-m: built-in accession list.
                                        With --public-m: first 2 rows per project, after any selection.
                                        Downloads complete Runs, not subsampled reads.
    -h, --help                          Show this help.

Examples:
    Meta2Data AmpliconPIP --test --vsearch -t 8
    Meta2Data AmpliconPIP --public-m metadata.csv --public-bioproject-colNAME Bioproject --public-sra-colNAME Run --vsearch
    Meta2Data AmpliconPIP --public-m metadata.csv --public-bioproject-colNAME Bioproject --public-sra-colNAME Run --public-bioprojectIDs PRJNA12345 PRJNA67890 --public-primer-fwd CCTACGGGNGGCWGCAG GTGYCAGCMGCCGCGGTAA --vsearch
    Meta2Data AmpliconPIP --local-m local_metadata.csv --local-datasets-colNAME datasets --local-path-colNAME path --local-platform-colNAME platform --dada2
    Meta2Data AmpliconPIP --public-m metadata.csv --public-bioproject-colNAME Bioproject --public-sra-colNAME Run --local-m local_metadata.csv --local-datasets-colNAME datasets --local-path-colNAME path --local-platform-colNAME platform --vsearch
    Meta2Data AmpliconTAXA --vsearch -i results/pip --classifier greengenes

Major outputs:
    <dataset>/<dataset>-<method>-final-table.qza
    <dataset>/<dataset>-<method>-final-rep-seqs.qza
    summary.csv, pip_dataset_read_counts.csv, per_dataset_summary.tsv
    datasets.log, logs/<dataset>.log
    selected_metadata.csv, project_primers.json (selected-project mode only)
    local_datasets.json (local input and per-dataset primers)
EOF
}

METADATA=""
THREADS=4
MAX_PARALLEL=2
TEST_MODE=false
MODE=""

COL_BIOPROJECT=""
COL_SRA=""
LOCAL_METADATA=""
LOCAL_MANIFEST=""
LOCAL_COL_DATASETS=""
LOCAL_COL_PATH=""
LOCAL_COL_PLATFORM=""
LOCAL_COL_PRIMER_F=""
LOCAL_COL_PRIMER_R=""
LOCAL_COLUMNS_SET=false
BIOPROJECT_IDS=()
PRIMER_FWDS=()
PRIMER_REVS=()
PROJECT_PRIMER_MAP=""
START_CWD="$(pwd -P)"

# Validate the public interface before loading configuration or writing results.
_args=("$@")
for (( _i=0; _i<${#_args[@]}; _i++ )); do
    _option="${_args[$_i]}"
    _replacement=""
    case "${_option%%=*}" in
        --adapter-ref|--adapter-cache)
            echo "Error: ${_option%%=*} has been removed. Adapter protection automatically uses GG2; its cache is fixed at results/db/adapter_guard/ in the startup working directory." >&2
            exit 2
            ;;
        -m|--metadata) _replacement="--public-m" ;;
        --col-bioproject) _replacement="--public-bioproject-colNAME" ;;
        --col-sra) _replacement="--public-sra-colNAME" ;;
        --bioprojectIDs) _replacement="--public-bioprojectIDs" ;;
        --primer-fwd) _replacement="--public-primer-fwd" ;;
        --primer-rev) _replacement="--public-primer-rev" ;;
        --local-col-datasets) _replacement="--local-datasets-colNAME" ;;
        --local-col-path) _replacement="--local-path-colNAME" ;;
        --local-col-platform) _replacement="--local-platform-colNAME" ;;
        --local-col-primer-f) _replacement="--local-primer-f-colNAME" ;;
        --local-col-primer-r) _replacement="--local-primer-r-colNAME" ;;
    esac
    if [[ -n "$_replacement" ]]; then
        echo "Error: ${_option%%=*} has been removed. Use $_replacement instead; see --help." >&2
        exit 2
    fi
    case "$_option" in
        --public-m|--public-bioproject-colNAME|--public-sra-colNAME|\
        --local-m|--local-datasets-colNAME|--local-path-colNAME|--local-platform-colNAME|\
        --local-primer-f-colNAME|--local-primer-r-colNAME|\
        -t|--threads|--max-parallel|--parameter)
            _value="${_args[$((_i+1))]:-}"
            [[ -n "$_value" && "$_value" != -* ]] || {
                echo "Error: $_option requires a value" >&2
                exit 2
            }
            ;;
        --public-bioprojectIDs|--public-primer-fwd|--public-primer-rev)
            _value="${_args[$((_i+1))]:-}"
            [[ -n "$_value" && "$_value" != -* ]] || {
                echo "Error: $_option requires one or more values" >&2
                exit 2
            }
            ;;
    esac
done

# Load configuration first; explicit command-line options below take precedence.
PARAMETER_FILE=""
for (( _i=0; _i<${#_args[@]}; _i++ )); do
    if [[ "${_args[$_i]}" == "--parameter" ]]; then
        PARAMETER_FILE="${_args[$((_i+1))]:-}"
        [[ -n "$PARAMETER_FILE" ]] || { echo "Error: --parameter requires a JSON file" >&2; exit 2; }
        PARAMETER_FILE=$(realpath "$PARAMETER_FILE")
    fi
done
_config_args=()
[[ -n "$PARAMETER_FILE" ]] && _config_args+=(--parameter "$PARAMETER_FILE")
_config=$(python3 "${SCRIPTS}/parameters.py" shell "${_config_args[@]}") || exit 2
eval "$_config"
export PARAMETER_FILE

while [[ $# -gt 0 ]]; do
    case $1 in
        --public-m)
            METADATA="$2"
            shift 2
            ;;
        --local|--localinput|--input|--localIDs|--platform)
            echo "Error: $1 has been removed. Use --local-m local_metadata.csv with dataset, path, platform and optional primer columns; see --help." >&2
            exit 2
            ;;
        --local-m|--local-datasets-colNAME|--local-path-colNAME|--local-platform-colNAME|--local-primer-f-colNAME|--local-primer-r-colNAME)
            case "$1" in
                --local-m) LOCAL_METADATA="$2" ;;
                --local-datasets-colNAME) LOCAL_COL_DATASETS="$2"; LOCAL_COLUMNS_SET=true ;;
                --local-path-colNAME) LOCAL_COL_PATH="$2"; LOCAL_COLUMNS_SET=true ;;
                --local-platform-colNAME) LOCAL_COL_PLATFORM="$2"; LOCAL_COLUMNS_SET=true ;;
                --local-primer-f-colNAME) LOCAL_COL_PRIMER_F="$2"; LOCAL_COLUMNS_SET=true ;;
                --local-primer-r-colNAME) LOCAL_COL_PRIMER_R="$2"; LOCAL_COLUMNS_SET=true ;;
            esac
            shift 2
            ;;
        --dada2)
            if [[ -n "$MODE" ]]; then
                echo "Error: --dada2 and --vsearch are mutually exclusive; specify exactly one"
                exit 1
            fi
            MODE="dada2"
            shift
            ;;
        --vsearch)
            if [[ -n "$MODE" ]]; then
                echo "Error: --dada2 and --vsearch are mutually exclusive; specify exactly one"
                exit 1
            fi
            MODE="vsearch"
            shift
            ;;
        -o|--output|--output=*)
            echo "Error: $1 has been removed. AmpliconPIP writes to results/pip/ in the startup working directory; start another analysis from a different working directory." >&2
            exit 2
            ;;
        -t|--threads)
            THREADS="$2"
            shift 2
            ;;
        --max-parallel)
            MAX_PARALLEL="$2"
            shift 2
            ;;
        --parameter) shift 2 ;;
        --adapter-guard) export ADAPTER_GUARD_ENABLED=true; shift ;;
        --no-adapter-guard) export ADAPTER_GUARD_ENABLED=false; shift ;;
        --db|--dl)
            echo "Error: $1 has been removed; adapter references are prepared automatically in results/db/." >&2
            exit 2
            ;;
        --skip-unknown-primers) export SKIP_UNKNOWN_PRIMERS=true; shift ;;
        --test)
            TEST_MODE=true
            shift
            ;;
        --public-bioproject-colNAME)
            COL_BIOPROJECT="$2"
            shift 2
            ;;
        --public-sra-colNAME)
            COL_SRA="$2"
            shift 2
            ;;
        --public-bioprojectIDs|--public-primer-fwd|--public-primer-rev)
            _list_option="$1"
            shift
            _values=()
            while [[ $# -gt 0 && "$1" != -* ]]; do
                _values+=("$1")
                shift
            done
            [[ ${#_values[@]} -gt 0 ]] || { echo "Error: $_list_option requires one or more values" >&2; exit 2; }
            case "$_list_option" in
                --public-bioprojectIDs) BIOPROJECT_IDS+=("${_values[@]}") ;;
                --public-primer-fwd) PRIMER_FWDS+=("${_values[@]}") ;;
                --public-primer-rev) PRIMER_REVS+=("${_values[@]}") ;;
            esac
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'"
            show_help
            exit 1
            ;;
    esac
done

# Local datasets and primers are configured per row; command-line primers are
# reserved for selected online projects. Validate scope before any side effects.
if [[ -n "$LOCAL_METADATA" ]]; then
    [[ "$TEST_MODE" == false ]] || { echo "Error: --test is online-only and cannot be combined with --local-m" >&2; exit 2; }
    [[ ${#BIOPROJECT_IDS[@]} -eq 0 ]] || { echo "Error: --public-bioprojectIDs cannot be combined with --local-m; mixed input supports ordinary online metadata only" >&2; exit 2; }
elif [[ "$LOCAL_COLUMNS_SET" == true ]]; then
    echo "Error: --local-*-colNAME options require --local-m FILE" >&2
    exit 2
fi
[[ -z "$LOCAL_COL_PRIMER_R" || -n "$LOCAL_COL_PRIMER_F" ]] || {
    echo "Error: --local-primer-r-colNAME requires --local-primer-f-colNAME" >&2; exit 2;
}
if [[ -z "$METADATA" && -n "$LOCAL_METADATA" && ( -n "$COL_BIOPROJECT" || -n "$COL_SRA" ) ]]; then
    echo "Error: --public-bioproject-colNAME and --public-sra-colNAME require online --public-m input" >&2
    exit 2
fi
if [[ ${#BIOPROJECT_IDS[@]} -gt 0 ]]; then
    [[ -n "$METADATA" && -n "$COL_BIOPROJECT" && -n "$COL_SRA" ]] || {
        echo "Error: --public-bioprojectIDs requires --public-m, --public-bioproject-colNAME and --public-sra-colNAME" >&2; exit 2;
    }
    [[ ${#PRIMER_FWDS[@]} -eq ${#BIOPROJECT_IDS[@]} ]] || {
        echo "Error: --public-primer-fwd must provide one primer per --public-bioprojectIDs entry" >&2; exit 2;
    }
    [[ ${#PRIMER_REVS[@]} -eq 0 || ${#PRIMER_REVS[@]} -eq ${#BIOPROJECT_IDS[@]} ]] || {
        echo "Error: --public-primer-rev must provide one primer per --public-bioprojectIDs entry, or be omitted entirely" >&2; exit 2;
    }
elif [[ ${#PRIMER_FWDS[@]} -gt 0 || ${#PRIMER_REVS[@]} -gt 0 ]]; then
    echo "Error: online explicit primers require --public-bioprojectIDs; local primers must be mapped from --local-m CSV columns" >&2
    exit 2
fi

# Dataset, path and platform column mappings must be explicit for all local input,
# including commands that also process online metadata.
if [[ -n "$LOCAL_METADATA" ]]; then
    [[ -n "$LOCAL_COL_DATASETS" ]] || {
        echo "Error: --local-m requires --local-datasets-colNAME NAME to identify the dataset name column" >&2
        exit 2
    }
    [[ -n "$LOCAL_COL_PATH" ]] || {
        echo "Error: --local-m requires --local-path-colNAME NAME to identify the FASTQ directory column" >&2
        exit 2
    }
    [[ -n "$LOCAL_COL_PLATFORM" ]] || {
        echo "Error: --local-m requires --local-platform-colNAME NAME to identify the sequencing platform column" >&2
        exit 2
    }
fi

# Validate thread count is a positive integer
if ! [[ "$THREADS" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --threads must be a positive integer, got '$THREADS'"
    exit 1
fi

# Validate max-parallel count
if ! [[ "$MAX_PARALLEL" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --max-parallel must be a positive integer, got '$MAX_PARALLEL'"
    exit 1
fi

METADATA="${METADATA%/}"

if [[ "$TEST_MODE" == true ]]; then
    if [[ -n "$METADATA" ]]; then
        # --test with user-provided metadata file:
        # Subset to first 2 SRA entries per BioProject
        echo "Test mode enabled with user metadata: $METADATA"

        if [[ -z "$COL_BIOPROJECT" ]]; then
            echo "Error: --public-bioproject-colNAME is required when using --test with --public-m"
            show_help
            exit 1
        fi
        if [[ -z "$COL_SRA" ]]; then
            echo "Error: --public-sra-colNAME is required when using --test with --public-m"
            show_help
            exit 1
        fi

        if [[ ! -f "$METADATA" ]]; then
            echo "Error: Metadata file '$METADATA' not found"
            exit 1
        fi


    else
        TEST_FILE="ampliconpiptest.csv"

        # Search paths (in order of preference)
        SEARCH_PATHS=(
            "${SCRIPT_DIR}/test/${TEST_FILE}"                    # Development/git repo
            "${SCRIPT_DIR}/share/Meta2Data/test/${TEST_FILE}"    # pip install --target
            "/usr/local/share/Meta2Data/test/${TEST_FILE}"       # System install
            "${HOME}/.local/share/Meta2Data/test/${TEST_FILE}"   # User install (pip install --user)
            "${CONDA_PREFIX}/share/Meta2Data/test/${TEST_FILE}"  # Conda install
            "${PREFIX}/share/Meta2Data/test/${TEST_FILE}"        # Alternative prefix
        )

        for path in "${SEARCH_PATHS[@]}"; do
            if [[ -f "$path" ]]; then
                METADATA="$path"
                break
            fi
        done

        if [[ -z "$METADATA" ]]; then
            echo "Error: Test metadata file not found in any of these locations:"
            for path in "${SEARCH_PATHS[@]}"; do
                echo "  - $path"
            done
            echo ""
            echo "Hint: The test file may not be included in pip installations."
            echo "      Use --public-m /path/to/your/metadata.csv instead of --test"
            exit 1
        fi

        COL_BIOPROJECT="Bioproject"
        COL_SRA="Run"
        echo "Test mode enabled: Using $METADATA"
    fi
fi

# Either input may be used alone; together they share one processing queue.
if [[ -z "$METADATA" && -z "$LOCAL_METADATA" ]]; then
    echo "Error: provide --public-m, --local-m, or --test" >&2
    exit 2
fi
if [[ -n "$METADATA" && ( -z "$COL_BIOPROJECT" || -z "$COL_SRA" ) ]]; then
    echo "Error: online metadata requires --public-bioproject-colNAME and --public-sra-colNAME" >&2
    exit 2
fi

# Denoising mode is mandatory: exactly one of --dada2 / --vsearch, no default.
# (Replaces the old auto-mix-by-platform behaviour, which silently mixed
#  ASV and OTU results within a run and was a hidden batch-effect risk.)
if [[ -z "$MODE" ]]; then
    echo "Error: a denoising mode is required — specify exactly one of --dada2 or --vsearch"
    show_help
    exit 1
fi

# Resolve each CSV independently. Local FASTQ paths are relative to its CSV.
if [[ -n "$METADATA" ]]; then
    [[ -f "$METADATA" ]] || { echo "Error: Metadata file '$METADATA' not found" >&2; exit 2; }
    METADATA=$(cd "$(dirname "$METADATA")" && pwd -P)/$(basename "$METADATA")
fi
if [[ -n "$LOCAL_METADATA" ]]; then
    [[ -f "$LOCAL_METADATA" ]] || { echo "Error: Local metadata CSV '$LOCAL_METADATA' not found" >&2; exit 2; }
    LOCAL_METADATA=$(cd "$(dirname "$LOCAL_METADATA")" && pwd -P)/$(basename "$LOCAL_METADATA")
fi
OUTPUT="${START_CWD}/results/pip"
mkdir -p "$OUTPUT"
OUTPUT=$(cd "$OUTPUT" && pwd -P)

# Protect shared manifests, dataset lists, checkpoints and summaries across
# independent PIP commands. Python locks the inherited open-file description;
# this shell keeps it open for the entire run, including parallel workers.
exec {PIP_OUTPUT_LOCK_FD}>>"${OUTPUT}/.pip.lock"
python3 - "$PIP_OUTPUT_LOCK_FD" "$OUTPUT" <<'LOCK_PY'
import fcntl
import sys
try:
    fcntl.flock(int(sys.argv[1]), fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    print(f"Error: another AmpliconPIP command is using output directory {sys.argv[2]}. "
          "Wait for it to finish or start the other analysis from a different working directory. "
          "Use --max-parallel for datasets within one run.", file=sys.stderr)
    sys.exit(2)
LOCK_PY

# Never overwrite a user's metadata when generated test files share its name.
if [[ "$TEST_MODE" == true && "$METADATA" -ef "${OUTPUT}/test_subset_meta.csv" ]]; then
    echo "Error: input metadata would be overwritten by test_subset_meta.csv; move the input CSV outside results/pip/ or start from another working directory" >&2
    exit 2
fi

if [[ ${#BIOPROJECT_IDS[@]} -gt 0 ]]; then
    _selection_args=(prepare --metadata "$METADATA" --output "$OUTPUT"
        --col-bioproject "$COL_BIOPROJECT" --col-sra "$COL_SRA"
        --projects "${BIOPROJECT_IDS[@]}" --forward "${PRIMER_FWDS[@]}")
    [[ ${#PRIMER_REVS[@]} -gt 0 ]] && _selection_args+=(--reverse "${PRIMER_REVS[@]}")
    python3 "${SCRIPTS}/project_primers.py" "${_selection_args[@]}" || exit 2
    METADATA="${OUTPUT}/selected_metadata.csv"
    PROJECT_PRIMER_MAP="${OUTPUT}/project_primers.json"
fi

# Selection comes first; test mode then takes two rows per selected project.
if [[ "$TEST_MODE" == true && -n "$COL_BIOPROJECT" ]]; then
    SUBSET_META=$(python3 "${SCRIPTS}/py_16s.py" subset_meta_for_test \
        --FilePath "$METADATA" --Bioproject "$COL_BIOPROJECT" \
        --SRA_Number "$COL_SRA" --OutputDir "$OUTPUT" | tail -1)
    [[ -f "$SUBSET_META" ]] || { echo "Error: Failed to create test subset metadata file" >&2; exit 2; }
    METADATA="$SUBSET_META"
fi

if [[ -n "$METADATA" ]]; then
    python3 "${SCRIPTS}/local_datasets.py" check-online --metadata "$METADATA" \
        --col-bioproject "$COL_BIOPROJECT" --output "$OUTPUT" || exit 2
fi

if [[ -n "$LOCAL_METADATA" ]]; then
    _local_args=(prepare --metadata "$LOCAL_METADATA" --output "$OUTPUT"
        --col-datasets "$LOCAL_COL_DATASETS" --col-path "$LOCAL_COL_PATH"
        --col-platform "$LOCAL_COL_PLATFORM")
    [[ -n "$LOCAL_COL_PRIMER_F" ]] && _local_args+=(--col-primer-f "$LOCAL_COL_PRIMER_F")
    [[ -n "$LOCAL_COL_PRIMER_R" ]] && _local_args+=(--col-primer-r "$LOCAL_COL_PRIMER_R")
    [[ -n "$METADATA" ]] && _local_args+=(--online-metadata "$METADATA" --col-bioproject "$COL_BIOPROJECT" --col-sra "$COL_SRA")
    LOCAL_MANIFEST=$(python3 "${SCRIPTS}/local_datasets.py" "${_local_args[@]}") || exit 2
    [[ -f "$LOCAL_MANIFEST" ]] || { echo "Error: local preflight did not produce a manifest" >&2; exit 2; }
fi

python3 "${SCRIPTS}/parameters.py" save "${_config_args[@]}" --output "${OUTPUT}/effective-parameters-${MODE}.json"

# Check required tools
[[ -f "${SCRIPTS}/py_16s.py" ]] || { echo "Error: 'py_16s.py' not found at ${SCRIPTS}/py_16s.py"; exit 1; }

# Display configuration
echo "========================================="
echo "Meta2Data AmpliconPIP"
echo "========================================="
[[ -n "$METADATA" ]] && echo "Online metadata: $METADATA"
[[ -n "$LOCAL_METADATA" ]] && echo "Local metadata:  $LOCAL_METADATA"
echo "Output:         $OUTPUT"
echo "Threads:        $THREADS"
echo "Mode:           $MODE"
echo "BioProject Col: $COL_BIOPROJECT"
echo "SRA Col:        $COL_SRA"
echo "========================================="
echo ""

export cpu=$THREADS

# Redirect ALL temporary-file paths to the output directory so that the
# pipeline never touches the small /tmp on HPC compute nodes.
#   TMPDIR / TEMP / TMP  – Python tempfile, C runtime, Java, etc.
#   QIIME2_CACHE          – QIIME2's own artifact cache (the actual source
#                           of the "No space left on device" error).
#   PYTHONWARNINGS        – suppress the seaborn/pandas FutureWarning about
#                           the deprecated use_inf_as_na option.
PIPELINE_TMPDIR="${OUTPUT}/.tmpdir"
mkdir -p "$PIPELINE_TMPDIR"
export TMPDIR="$PIPELINE_TMPDIR"
export TEMP="$PIPELINE_TMPDIR"
export TMP="$PIPELINE_TMPDIR"
export QIIME2_CACHE="${PIPELINE_TMPDIR}/qiime2-cache"
mkdir -p "$QIIME2_CACHE"
export PYTHONWARNINGS="ignore::FutureWarning"

# Prepare the immutable reference index before parallel dataset workers start.
export M2D_ADAPTER_GUARD_ENABLED=0
if [[ "$ADAPTER_GUARD_ENABLED" == true ]]; then
    GG2_GUARD_REF=$(python3 "${SCRIPTS}/reference_resources.py" prepare \
        --kind gg2-sequences --work-dir "$START_CWD") || exit 2
    [[ -s "$GG2_GUARD_REF" ]] || { echo "Error: Missing GG2 adapter-guard reference: $GG2_GUARD_REF" >&2; exit 2; }
    mkdir -p "${START_CWD}/results/db/adapter_guard"
    export M2D_ADAPTER_GUARD_CACHE="$(cd "${START_CWD}/results/db/adapter_guard" && pwd -P)"
    M2D_ADAPTER_GUARD_DB_MANIFEST=$(python3 "${SCRIPTS}/fastp_guard.py" prepare \
        --reference "$GG2_GUARD_REF" --cache-dir "$M2D_ADAPTER_GUARD_CACHE") || exit 2
    export M2D_ADAPTER_GUARD_DB_MANIFEST M2D_ADAPTER_GUARD_ENABLED=1
    cp "$M2D_ADAPTER_GUARD_DB_MANIFEST" "${OUTPUT}/adapter_guard_reference.json"
fi

################################################################################
#                    AMPLICON PROCESSING PIPELINE                              #
################################################################################

echo "========================================="
echo "Running Amplicon Processing Pipeline"
echo "Started: $(date)"
echo "========================================="
echo ""

# The runner accepts online metadata, a local manifest, or both.
EXTRA_ARGS=()
[[ -n "$METADATA" ]] && EXTRA_ARGS+=(-m "$METADATA")
[[ -n "$LOCAL_MANIFEST" ]] && EXTRA_ARGS+=(--local-manifest "$LOCAL_MANIFEST")
[[ -n "$PROJECT_PRIMER_MAP" ]] && EXTRA_ARGS+=(--project-primers "$PROJECT_PRIMER_MAP")

# Call run.sh to handle all processing
if ! bash "${SCRIPTS}/run.sh" \
    -o "$OUTPUT" \
    -t "$THREADS" \
    --max-parallel "$MAX_PARALLEL" \
    --col-bioproject "$COL_BIOPROJECT" \
    --col-sra "$COL_SRA" \
    --mode "$MODE" \
    "${EXTRA_ARGS[@]}"; then
    echo "[ERROR] Amplicon processing pipeline failed"
    echo "Check logs in: $OUTPUT"
    echo "QIIME2 tmpdir preserved for debugging: $PIPELINE_TMPDIR"
    exit 1
fi

echo ""
echo "[OK] Amplicon processing completed successfully"
echo ""

################################################################################
#                             Final Summary                                    #
################################################################################

echo "========================================="
echo "PROCESSING COMPLETE"
echo "Finished: $(date)"
echo "========================================="
echo ""

# Per-run status summary from the unified append-only log. This run's section =
# the entries after the most recent "# === RUN" header (run.sh prints the same tally).
run_log="${OUTPUT}/datasets.log"
if [ -f "$run_log" ]; then
    awk -F'\t' '
        /^# === RUN/ { s = NR }
        { f2[NR] = $2 }
        END {
            for (i = s + 1; i <= NR; i++) {
                if (f2[i] == "SUCCESS") su++
                else if (f2[i] == "FAILED") fa++
                else if (f2[i] == "SKIPPED") sk++
                else if (f2[i] == "LOW_QUALITY") lq++
            }
            printf "Successful datasets:  %d\n", su + 0
            if (fa > 0) printf "Failed datasets:      %d\n", fa
            if (sk > 0) printf "Skipped datasets:     %d\n", sk
            if (lq > 0) printf "Low-quality datasets: %d\n", lq
        }
    ' "$run_log"
    echo "[WARNING]  Failed details (if any) and full history: $run_log"
fi

echo ""
echo "Results saved in: $OUTPUT"
echo "To assign taxonomy, run: Meta2Data AmpliconTAXA --$MODE -i $OUTPUT --classifier greengenes"
echo "========================================="
