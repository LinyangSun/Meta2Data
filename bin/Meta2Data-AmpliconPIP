#!/bin/bash
set -e

# Find scripts directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Search for scripts directory in multiple possible locations
find_scripts_dir() {
    local search_paths=(
        "${SCRIPT_DIR}/scripts"                          # Development/git repo
        "${SCRIPT_DIR}/share/Meta2Data/scripts"          # pip install --target
        "/usr/local/share/Meta2Data/scripts"             # System install
        "${HOME}/.local/share/Meta2Data/scripts"         # User install (pip install --user)
        "${CONDA_PREFIX}/share/Meta2Data/scripts"        # Conda install
        "${PREFIX}/share/Meta2Data/scripts"              # Alternative prefix
    )

    for path in "${search_paths[@]}"; do
        if [[ -d "$path" && -f "$path/AmpliconFunction.sh" ]]; then
            echo "$path"
            return 0
        fi
    done

    echo "ERROR: Scripts directory not found in any location:" >&2
    for path in "${search_paths[@]}"; do
        echo "  - $path" >&2
    done
    return 1
}

if ! SCRIPTS=$(find_scripts_dir); then
    echo "ERROR: Cannot find scripts directory"
    exit 1
fi

export M2D_PROFILE_MODULE=pip
source "${SCRIPTS}/resource_profile.sh"

show_help() {
    cat << EOF
Usage: Meta2Data AmpliconPIP [options]

Download and process amplicon sequencing data based on user provided metadata.

Options:
    -m, --metadata PATH       Metadata CSV, or a FASTQ folder with --local
    --col-bioproject Chr     Column name for BioProject in metadata (required for metadata input unless --test)
    --col-sra Chr            Column name for SRA accession in metadata (required for metadata input unless --test)
    --dada2 | --vsearch       Denoising mode (REQUIRED: specify exactly one; no default).
                              --dada2 : DADA2 only, single-base ASV resolution.
                                      Platforms Illumina / Ion Torrent / PacBio CCS;
                                      454, ONT and degraded/binned quality are skipped.
                              --vsearch : vsearch only, 97%-identity OTU.
                                      Platform-specific processing for all 5 platforms.

Optional options:
    -o, --output DIR          Output base directory
                              Default: current directory in --test mode
                                       metadata file directory in normal mode
    -t, --threads int         Total CPU threads available (default: 4)
                              Automatically split across parallel datasets:
                              per-dataset threads = threads ÷ max-parallel
    --max-parallel int        Number of datasets to process in parallel (default: 2)
    --local                  Read one local FASTQ folder given with -m; no download.
    --platform PLATFORM      Required with --local: ILLUMINA, LS454, ION_TORRENT,
                              PACBIO_SMRT or OXFORD_NANOPORE.
    --primer-fwd SEQUENCE     Explicit forward primer (optional).
    --primer-rev SEQUENCE     Explicit reverse primer (optional).
    --skip-unknown-primers    Skip a dataset when an unknown primer is detected.
                              Default: trim 20 bp when no database match and fold <16.
    --parameter FILE         JSON overrides; see docs/parameters.default.json.
    --adapter-guard          Check inferred adapters against a 16S reference;
                              retry protected samples without de novo trimming.
    --no-adapter-guard       Disable the optional adapter guard (default).
    --adapter-ref FILE       16S FASTA or FeatureData[Sequence] QZA for the guard.
    --db DIR                 Reuse TAXA's GG2 reference directory for the guard.
    --dl                     Download a missing GG2 backbone into --db.
    --adapter-cache DIR      Shared BLAST index/query cache (default: <db>/adapter_guard).
    --test                    Run in test mode.
                              If -m is provided: subset metadata (2 SRA per BioProject)
                              If -m is omitted:  use built-in test file
                              Output defaults to current directory in test mode
    -h, --help                Show this help message

Metadata CSV file format:
    Required columns (customizable with --col-* options):
    - Bioproject          : BioProject accession (e.g., PRJNA123456)
    - Run                 : SRA run accession (e.g., SRR123456)

Example CSV:
    Bioproject,Run
    PRJNA12345,SRR123456
    PRJNA12345,SRR123457

Example usage:
    # Test mode (built-in test data) — a denoising mode is still required
    Meta2Data AmpliconPIP --test --vsearch -t 8

    # Test mode (with user metadata: 2 SRA per BioProject)
    Meta2Data AmpliconPIP --test --vsearch -m metadata.csv --col-bioproject Bioproject --col-sra Run -t 8

    # Basic usage
    Meta2Data AmpliconPIP -m metadata.csv --col-bioproject Bioproject --col-sra Run --dada2 -t 8

    # Custom output directory
    Meta2Data AmpliconPIP -m metadata.csv -o /output/ --col-bioproject Bioproject --col-sra Run --dada2 -t 8

    # DADA2 mode (DADA2) — explicit mode is required
    Meta2Data AmpliconPIP -m metadata.csv --col-bioproject Bioproject --col-sra Run --dada2 -t 8

    # vsearch mode (vsearch 97%, genus level)
    Meta2Data AmpliconPIP -m metadata.csv --col-bioproject Bioproject --col-sra Run --vsearch -t 8

    # Then assign taxonomy separately (recommended) — mode must match the PIP run
    Meta2Data AmpliconTAXA --vsearch --db /path/to/gg2db -i /output/ -t 8

Output structure:
    <output_dir>/
    ├── datasets_ID.txt              # Generated dataset list
    ├── <dataset_ID>/                # One directory per dataset
    │   ├── <dataset_ID>_sra.txt     # SRA accession list
    │   ├── <dataset_ID>-<mode>-final-rep-seqs.qza  # Final sequences (mode=dada2|vsearch)
    │   └── <dataset_ID>-<mode>-final-table.qza     # Final feature table
    ├── failed_datasets.log
    ├── success_datasets.log
    └── skipped_datasets.log

EOF
}

METADATA=""
OUTPUT=""
THREADS=4
MAX_PARALLEL=2
TEST_MODE=false
MODE=""

COL_BIOPROJECT=""
COL_SRA=""
LOCAL_MODE=false
LOCAL_PLATFORM=""
PRIMER_FWD=""
PRIMER_REV=""
ADAPTER_REF=""
ADAPTER_DB_DIR=""
ADAPTER_DL=false
ADAPTER_CACHE=""

# Load configuration first; explicit command-line options below take precedence.
PARAMETER_FILE=""
_args=("$@")
for (( _i=0; _i<${#_args[@]}; _i++ )); do
    if [[ "${_args[$_i]}" == "--parameter" ]]; then
        PARAMETER_FILE="${_args[$((_i+1))]:-}"
        [[ -n "$PARAMETER_FILE" ]] || { echo "Error: --parameter requires a JSON file" >&2; exit 2; }
        PARAMETER_FILE=$(realpath "$PARAMETER_FILE")
    fi
done
_config_args=()
[[ -n "$PARAMETER_FILE" ]] && _config_args+=(--parameter "$PARAMETER_FILE")
_config=$(python3 "${SCRIPTS}/parameters.py" shell "${_config_args[@]}") || exit 2
eval "$_config"
export PARAMETER_FILE

while [[ $# -gt 0 ]]; do
    case $1 in
        -m|--metadata)
            METADATA="$2"
            shift 2
            ;;
        --dada2)
            if [[ -n "$MODE" ]]; then
                echo "Error: --dada2 and --vsearch are mutually exclusive; specify exactly one"
                exit 1
            fi
            MODE="dada2"
            shift
            ;;
        --vsearch)
            if [[ -n "$MODE" ]]; then
                echo "Error: --dada2 and --vsearch are mutually exclusive; specify exactly one"
                exit 1
            fi
            MODE="vsearch"
            shift
            ;;
        -o|--output)
            OUTPUT="$2"
            shift 2
            ;;
        -t|--threads)
            THREADS="$2"
            shift 2
            ;;
        --max-parallel)
            MAX_PARALLEL="$2"
            shift 2
            ;;
        --parameter) shift 2 ;;
        --adapter-guard) export ADAPTER_GUARD_ENABLED=true; shift ;;
        --no-adapter-guard) export ADAPTER_GUARD_ENABLED=false; shift ;;
        --adapter-ref) ADAPTER_REF="$2"; shift 2 ;;
        --db) ADAPTER_DB_DIR="$2"; shift 2 ;;
        --dl) ADAPTER_DL=true; shift ;;
        --adapter-cache) ADAPTER_CACHE="$2"; shift 2 ;;
        --skip-unknown-primers) export SKIP_UNKNOWN_PRIMERS=true; shift ;;
        --test)
            TEST_MODE=true
            shift
            ;;
        --col-bioproject)
            COL_BIOPROJECT="$2"
            shift 2
            ;;
        --col-sra)
            COL_SRA="$2"
            shift 2
            ;;
        --local)
            LOCAL_MODE=true
            shift
            ;;
        --platform)
            LOCAL_PLATFORM="$2"
            shift 2
            ;;
        --primer-fwd)
            PRIMER_FWD="$2"
            shift 2
            ;;
        --primer-rev)
            PRIMER_REV="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'"
            show_help
            exit 1
            ;;
    esac
done

# Validate thread count is a positive integer
if ! [[ "$THREADS" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --threads must be a positive integer, got '$THREADS'"
    exit 1
fi

# Validate max-parallel count
if ! [[ "$MAX_PARALLEL" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --max-parallel must be a positive integer, got '$MAX_PARALLEL'"
    exit 1
fi

METADATA="${METADATA%/}"
OUTPUT="${OUTPUT%/}"

if [[ "$TEST_MODE" == true ]]; then
    if [[ -n "$METADATA" ]]; then
        # --test with user-provided metadata file:
        # Subset to first 2 SRA entries per BioProject
        echo "Test mode enabled with user metadata: $METADATA"

        if [[ -z "$COL_BIOPROJECT" ]]; then
            echo "Error: --col-bioproject is required when using --test with -m"
            show_help
            exit 1
        fi
        if [[ -z "$COL_SRA" ]]; then
            echo "Error: --col-sra is required when using --test with -m"
            show_help
            exit 1
        fi

        if [[ ! -f "$METADATA" ]]; then
            echo "Error: Metadata file '$METADATA' not found"
            exit 1
        fi

        if [[ -n "$OUTPUT" ]]; then
            mkdir -p "$OUTPUT"
            SUBSET_DIR="$OUTPUT"
        else
            SUBSET_DIR=$(pwd)
        fi

        SUBSET_META=$(python3 "${SCRIPTS}/py_16s.py" subset_meta_for_test \
            --FilePath "$METADATA" \
            --Bioproject "$COL_BIOPROJECT" \
            --SRA_Number "$COL_SRA" \
            --OutputDir "$SUBSET_DIR" | tail -1)

        if [[ ! -f "$SUBSET_META" ]]; then
            echo "Error: Failed to create test subset metadata file"
            exit 1
        fi

        METADATA="$SUBSET_META"
        echo "Test mode: Using subset metadata $METADATA"
    else
        TEST_FILE="ampliconpiptest.csv"

        # Search paths (in order of preference)
        SEARCH_PATHS=(
            "${SCRIPT_DIR}/test/${TEST_FILE}"                    # Development/git repo
            "${SCRIPT_DIR}/share/Meta2Data/test/${TEST_FILE}"    # pip install --target
            "/usr/local/share/Meta2Data/test/${TEST_FILE}"       # System install
            "${HOME}/.local/share/Meta2Data/test/${TEST_FILE}"   # User install (pip install --user)
            "${CONDA_PREFIX}/share/Meta2Data/test/${TEST_FILE}"  # Conda install
            "${PREFIX}/share/Meta2Data/test/${TEST_FILE}"        # Alternative prefix
        )

        for path in "${SEARCH_PATHS[@]}"; do
            if [[ -f "$path" ]]; then
                METADATA="$path"
                break
            fi
        done

        if [[ -z "$METADATA" ]]; then
            echo "Error: Test metadata file not found in any of these locations:"
            for path in "${SEARCH_PATHS[@]}"; do
                echo "  - $path"
            done
            echo ""
            echo "Hint: The test file may not be included in pip installations."
            echo "      Use -m /path/to/your/metadata.csv instead of --test"
            exit 1
        fi

        COL_BIOPROJECT="Bioproject"
        COL_SRA="Run"
        echo "Test mode enabled: Using $METADATA"
    fi
fi

# Validate required parameters
if [[ -z "$METADATA" ]]; then
    echo "Error: --metadata is required (or use --test for test mode)"
    show_help
    exit 1
fi

if [[ "$LOCAL_MODE" == true ]]; then
    case "$LOCAL_PLATFORM" in
        ILLUMINA|LS454|ION_TORRENT|PACBIO_SMRT|OXFORD_NANOPORE) ;;
        *) echo "Error: --local requires --platform one of ILLUMINA|LS454|ION_TORRENT|PACBIO_SMRT|OXFORD_NANOPORE"; show_help; exit 1 ;;
    esac
else
    if [[ -z "$COL_BIOPROJECT" ]]; then
        echo "Error: --col-bioproject is required (or use --test for test mode)"
        show_help
        exit 1
    fi

    if [[ -z "$COL_SRA" ]]; then
        echo "Error: --col-sra is required (or use --test for test mode)"
        show_help
        exit 1
    fi
fi

# Denoising mode is mandatory: exactly one of --dada2 / --vsearch, no default.
# (Replaces the old auto-mix-by-platform behaviour, which silently mixed
#  ASV and OTU results within a run and was a hidden batch-effect risk.)
if [[ -z "$MODE" ]]; then
    echo "Error: a denoising mode is required — specify exactly one of --dada2 or --vsearch"
    show_help
    exit 1
fi

if [[ -n "$PRIMER_REV" && -z "$PRIMER_FWD" ]]; then
    echo "Error: --primer-rev requires --primer-fwd" >&2
    exit 2
fi

# Check input exists: a folder in --local mode, a CSV file otherwise
if [[ "$LOCAL_MODE" == true ]]; then
    if [[ ! -d "$METADATA" ]]; then
        echo "Error: --local input folder '$METADATA' not found"
        exit 1
    fi
elif [[ ! -f "$METADATA" ]]; then
    echo "Error: Metadata file '$METADATA' not found"
    exit 1
fi

if [[ "$LOCAL_MODE" == true ]]; then
    METADATA=$(cd "$METADATA" && pwd -P)
else
    METADATA=$(cd "$(dirname "$METADATA")" && pwd -P)/$(basename "$METADATA")
fi

if [[ -z "$OUTPUT" ]]; then
    if [[ "$LOCAL_MODE" == true ]]; then
        echo "Error: --local requires an explicit -o/--output directory (the input folder must not double as the output)"
        exit 1
    elif [[ "$TEST_MODE" == true ]]; then
        # In test mode, default to current working directory
        # (test metadata is inside package, can't write there)
        OUTPUT=$(pwd)
        echo "Output directory not specified, using current directory: $OUTPUT"
    else
        # Normal mode: use metadata file directory
        OUTPUT=$(dirname "$METADATA")
        echo "Output directory not specified, using metadata file directory: $OUTPUT"
    fi
else
    # User specified output directory
    mkdir -p "$OUTPUT"
    OUTPUT=$(cd "$OUTPUT" && pwd -P)
fi

if [[ "$LOCAL_MODE" == true ]] && { [[ "$OUTPUT" == "$METADATA" ]] || [[ "${OUTPUT}/$(basename "$METADATA")" == "$METADATA" ]]; }; then
    echo "Error: local output and its dataset directory must differ from the input FASTQ directory; choose a separate output folder" >&2
    exit 2
fi
if [[ "$LOCAL_MODE" == true ]]; then
    python3 "${SCRIPTS}/read_layout.py" validate-local --input "$METADATA" \
        --output "${OUTPUT}/$(basename "$METADATA")"
fi
python3 "${SCRIPTS}/parameters.py" save "${_config_args[@]}" --output "${OUTPUT}/effective-parameters-${MODE}.json"

# Source function library (AmpliconFunction.sh)
# Note: py_16s.py must be in PATH (installed via setup.py or conda env)
if [[ -f "${SCRIPTS}/AmpliconFunction.sh" ]]; then
    source "${SCRIPTS}/AmpliconFunction.sh"
else
    echo "Error: AmpliconFunction.sh not found at ${SCRIPTS}/AmpliconFunction.sh"
    exit 1
fi

# Check required tools
[[ -f "${SCRIPTS}/py_16s.py" ]] || { echo "Error: 'py_16s.py' not found at ${SCRIPTS}/py_16s.py"; exit 1; }

# Display configuration
echo "========================================="
echo "Meta2Data AmpliconPIP"
echo "========================================="
echo "Metadata:       $METADATA"
echo "Output:         $OUTPUT"
echo "Threads:        $THREADS"
echo "Mode:           $MODE"
echo "BioProject Col: $COL_BIOPROJECT"
echo "SRA Col:        $COL_SRA"
echo "========================================="
echo ""

export cpu=$THREADS

# Redirect ALL temporary-file paths to the output directory so that the
# pipeline never touches the small /tmp on HPC compute nodes.
#   TMPDIR / TEMP / TMP  – Python tempfile, C runtime, Java, etc.
#   QIIME2_CACHE          – QIIME2's own artifact cache (the actual source
#                           of the "No space left on device" error).
#   PYTHONWARNINGS        – suppress the seaborn/pandas FutureWarning about
#                           the deprecated use_inf_as_na option.
PIPELINE_TMPDIR="${OUTPUT}/.tmpdir"
mkdir -p "$PIPELINE_TMPDIR"
export TMPDIR="$PIPELINE_TMPDIR"
export TEMP="$PIPELINE_TMPDIR"
export TMP="$PIPELINE_TMPDIR"
export QIIME2_CACHE="${PIPELINE_TMPDIR}/qiime2-cache"
mkdir -p "$QIIME2_CACHE"
export PYTHONWARNINGS="ignore::FutureWarning"

# Prepare the immutable reference index before parallel dataset workers start.
export M2D_ADAPTER_GUARD_ENABLED=0
if [[ "$ADAPTER_GUARD_ENABLED" == true ]]; then
    if [[ -z "$ADAPTER_REF" ]]; then
        [[ -n "$ADAPTER_DB_DIR" ]] || {
            echo 'Error: --adapter-guard requires --adapter-ref or --db' >&2; exit 2;
        }
        ADAPTER_REF="${ADAPTER_DB_DIR%/}/2024.09.backbone.full-length.fna.qza"
    fi
    if [[ ! -s "$ADAPTER_REF" && "$ADAPTER_DL" == true ]]; then
        [[ -n "$ADAPTER_DB_DIR" && "$ADAPTER_REF" == "${ADAPTER_DB_DIR%/}/2024.09.backbone.full-length.fna.qza" ]] || {
            echo 'Error: --dl only downloads the GG2 backbone selected by --db' >&2; exit 2;
        }
        python3 "${SCRIPTS}/adapter_reference.py" --db "$ADAPTER_DB_DIR"
    fi
    [[ -s "$ADAPTER_REF" ]] || { echo "Error: Missing adapter-guard reference: $ADAPTER_REF" >&2; exit 2; }
    if [[ -z "$ADAPTER_CACHE" ]]; then
        ADAPTER_CACHE="${ADAPTER_DB_DIR:-${OUTPUT}/.reference}/adapter_guard"
    fi
    mkdir -p "$ADAPTER_CACHE"
    export M2D_ADAPTER_GUARD_CACHE="$(cd "$ADAPTER_CACHE" && pwd -P)"
    M2D_ADAPTER_GUARD_DB_MANIFEST=$(python3 "${SCRIPTS}/fastp_guard.py" prepare \
        --reference "$ADAPTER_REF" --cache-dir "$M2D_ADAPTER_GUARD_CACHE") || exit 2
    export M2D_ADAPTER_GUARD_DB_MANIFEST M2D_ADAPTER_GUARD_ENABLED=1
    cp "$M2D_ADAPTER_GUARD_DB_MANIFEST" "${OUTPUT}/adapter_guard_reference.json"
fi

################################################################################
#                    AMPLICON PROCESSING PIPELINE                              #
################################################################################

echo "========================================="
echo "Running Amplicon Processing Pipeline"
echo "Started: $(date)"
echo "========================================="
echo ""

# Extra flags for --local mode (platform + optional explicit primers)
EXTRA_ARGS=()
if [[ "$LOCAL_MODE" == true ]]; then
    EXTRA_ARGS+=(--local --platform "$LOCAL_PLATFORM")
fi
[[ -n "$PRIMER_FWD" ]] && EXTRA_ARGS+=(--primer-fwd "$PRIMER_FWD")
[[ -n "$PRIMER_REV" ]] && EXTRA_ARGS+=(--primer-rev "$PRIMER_REV")

# Call run.sh to handle all processing
if ! bash "${SCRIPTS}/run.sh" \
    -m "$METADATA" \
    -o "$OUTPUT" \
    -t "$THREADS" \
    --max-parallel "$MAX_PARALLEL" \
    --col-bioproject "$COL_BIOPROJECT" \
    --col-sra "$COL_SRA" \
    --mode "$MODE" \
    "${EXTRA_ARGS[@]}"; then
    echo "[ERROR] Amplicon processing pipeline failed"
    echo "Check logs in: $OUTPUT"
    echo "QIIME2 tmpdir preserved for debugging: $PIPELINE_TMPDIR"
    exit 1
fi

echo ""
echo "[OK] Amplicon processing completed successfully"
echo ""

################################################################################
#                             Final Summary                                    #
################################################################################

echo "========================================="
echo "PROCESSING COMPLETE"
echo "Finished: $(date)"
echo "========================================="
echo ""

# Per-run status summary from the unified append-only log. This run's section =
# the entries after the most recent "# === RUN" header (run.sh prints the same tally).
run_log="${OUTPUT}/datasets.log"
if [ -f "$run_log" ]; then
    awk -F'\t' '
        /^# === RUN/ { s = NR }
        { f2[NR] = $2 }
        END {
            for (i = s + 1; i <= NR; i++) {
                if (f2[i] == "SUCCESS") su++
                else if (f2[i] == "FAILED") fa++
                else if (f2[i] == "SKIPPED") sk++
                else if (f2[i] == "LOW_QUALITY") lq++
            }
            printf "Successful datasets:  %d\n", su + 0
            if (fa > 0) printf "Failed datasets:      %d\n", fa
            if (sk > 0) printf "Skipped datasets:     %d\n", sk
            if (lq > 0) printf "Low-quality datasets: %d\n", lq
        }
    ' "$run_log"
    echo "[WARNING]  Failed details (if any) and full history: $run_log"
fi

echo ""
echo "Results saved in: $OUTPUT"
echo "To assign taxonomy, run: Meta2Data AmpliconTAXA --$MODE --db <gg2db> -i $OUTPUT"
echo "========================================="
