#!/bin/bash
set -e

# Output and shared references are fixed beneath the physical launch directory.
WORK_DIR="$(pwd -P)"

# Resolve symlinks before locating sibling commands or packaged scripts.
_M2D_ENTRYPOINT="$(readlink -f -- "${BASH_SOURCE[0]}")" || {
    echo "ERROR: Cannot resolve Meta2Data entry point: ${BASH_SOURCE[0]}" >&2
    exit 1
}
SCRIPT_DIR="$(dirname -- "$(dirname -- "$_M2D_ENTRYPOINT")")"

# Search for scripts directory in multiple possible locations
find_scripts_dir() {
    local search_paths=(
        "${SCRIPT_DIR}/scripts"                          # Development/git repo
        "${SCRIPT_DIR}/share/Meta2Data/scripts"          # pip install --target
        "/usr/local/share/Meta2Data/scripts"             # System install
        "${HOME}/.local/share/Meta2Data/scripts"         # User install (pip install --user)
        "${CONDA_PREFIX}/share/Meta2Data/scripts"        # Conda install
        "${PREFIX}/share/Meta2Data/scripts"              # Alternative prefix
    )

    for path in "${search_paths[@]}"; do
        if [[ -d "$path" && -f "$path/taxonomy.sh" ]]; then
            echo "$path"
            return 0
        fi
    done

    echo "ERROR: Scripts directory not found in any location:" >&2
    for path in "${search_paths[@]}"; do
        echo "  - $path" >&2
    done
    return 1
}

if ! SCRIPTS=$(find_scripts_dir); then
    echo "ERROR: Cannot find scripts directory"
    exit 1
fi

export M2D_PROFILE_MODULE=taxa
source "${SCRIPTS}/resource_profile.sh"

show_help() {
    cat << EOF
Usage: Meta2Data AmpliconTAXA [options]

Recursively collect AmpliconPIP results, merge features, orient sequences against
GreenGenes2, assign taxonomy, and optionally build a phylogenetic tree. Dataset folders
may have any name. Each result must contain a matching pair:
    <id>-<method>-final-table.qza
    <id>-<method>-final-rep-seqs.qza

When one method is present it is selected automatically. If both dada2 and
vsearch results are present, select one explicitly; methods are never mixed.

Options:
    -i, --input DIR        PIP results directory (default: ./results/pip)
    --dada2 | --vsearch    Select a method; mutually exclusive, otherwise automatic
    --singleV             Single-region de novo tree (mafft + mask + fasttree)
                          Default: multi-region SEPP insertion and tree filtering
    --notree, --no-tree    Skip tree construction and tree-dependent filtering
                          Mutually exclusive with --singleV
    --parameter FILE      JSON parameter overrides (CLI options take precedence)
    --classifier TYPE     greengenes (default) or silva; missing classifier downloads automatically
    -t, --threads INT     CPU threads (default: 4)
    --confidence FLOAT    Classifier confidence (default: 0.7)
    -h, --help            Show this help

Orientation always uses the GreenGenes2 2024.09 backbone. Multi-region runs
use the existing Greengenes 13_8 SEPP reference regardless of feature method
or taxonomy classifier. --notree requires no SEPP reference. Tree mode is
independent of --dada2 / --vsearch.

All default paths are relative to the launch working directory:
    Input: ./results/pip   Output: ./results/taxa   References: ./results/db
Changing --input does not change either fixed output or reference location.
Valid cached or bundled references are reused; missing resources download
automatically. Only the selected classifier and required tree reference are prepared.

Database files:
    Always: 2024.09.backbone.full-length.fna.qza
    greengenes classifier: 2024.09.backbone.full-length.nb.qza
    silva classifier: silva-138-99-nb-classifier.qza
    SEPP runs only: sepp-refs-gg-13-8.qza

Examples:
    Meta2Data AmpliconTAXA
    Meta2Data AmpliconTAXA --dada2 --singleV
    Meta2Data AmpliconTAXA --notree --classifier silva
    Meta2Data AmpliconTAXA --vsearch --parameter settings.json

Outputs: results/taxa/final-<method>-<singleV|multiV|notree>/
    Single-region: orientedTable.qza, orientedRepSeqs.qza, denovoRootedTree.qza
    Multi-region: treeFilteredTable.qza, treeFilteredRepSeqs.qza, seppTree.qza
    No tree: orientedTable.qza, orientedRepSeqs.qza
    All: <DB>Taxonomy.qza, parameters.json, collection.json, taxa-run-state.json
    tmp/: intermediates and diagnostics

Changed inputs, parameters or references invalidate the affected cached steps.
Damaged TAXA state triggers recomputation of managed outputs. PIP results known
to belong to a previous input source are rejected; re-run that method first.
Incomplete or invalid input pairs and duplicate results are recorded in collection.json.
TAXA aggregate directories are identified by taxa-run-state.json and excluded.
Sample IDs must be unique across datasets; duplicate sample IDs stop the merge.
GG2 and SILVA classification outputs are cached independently.

EOF
}

# Default parameters
MODE=""
DB_DIR="${WORK_DIR}/results/db"
DB_TYPE="greengenes"
INPUT_DIR="${WORK_DIR}/results/pip"
OUTPUT="${WORK_DIR}/results/taxa"
INPUT_EXPLICIT=false
THREADS=4
CONFIDENCE=0.7
SINGLE_V=false
NOTREE=false
PARAMETER_FILE=""

# Load configuration before parsing explicit CLI overrides.
scan_args=("$@")
for ((i=0; i<${#scan_args[@]}; i++)); do
    if [[ "${scan_args[i]}" == "--parameter" ]]; then
        if ((i + 1 >= ${#scan_args[@]})); then
            echo "Error: --parameter requires a JSON file" >&2
            exit 1
        fi
        PARAMETER_FILE="${scan_args[i+1]}"
    fi
done
parameter_args=()
[[ -z "$PARAMETER_FILE" ]] || parameter_args=(--parameter "$PARAMETER_FILE")
parameter_exports=$(python3 "${SCRIPTS}/parameters.py" shell "${parameter_args[@]}")
eval "$parameter_exports"
export PARAMETER_FILE

# Fail clearly for missing values rather than passing option tokens as paths.
require_value() {
    if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        echo "Error: $1 requires a value" >&2
        exit 1
    fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dada2)
            if [[ -n "$MODE" && "$MODE" != "dada2" ]]; then
                echo "Error: --dada2 and --vsearch are mutually exclusive"
                exit 1
            fi
            MODE="dada2"
            shift
            ;;
        --vsearch)
            if [[ -n "$MODE" && "$MODE" != "vsearch" ]]; then
                echo "Error: --dada2 and --vsearch are mutually exclusive"
                exit 1
            fi
            MODE="vsearch"
            shift
            ;;
        --singleV)
            SINGLE_V=true
            shift
            ;;
        --notree|--no-tree)
            NOTREE=true
            shift
            ;;
        --parameter)
            shift 2
            ;;
        --classifier)
            require_value "$@"
            DB_TYPE="$2"
            shift 2
            ;;
        --db|--db-type|--dl)
            echo "Error: $1 was removed. References are prepared automatically in ./results/db; select --classifier greengenes or --classifier silva." >&2
            exit 1
            ;;
        --confidence)
            require_value "$@"
            CONFIDENCE="$2"
            shift 2
            ;;
        -i|--input)
            require_value "$@"
            INPUT_DIR="$2"
            INPUT_EXPLICIT=true
            shift 2
            ;;
        -o|--output|--output=*)
            echo "Error: ${1%%=*} was removed. AmpliconTAXA always writes to ./results/taxa beneath the launch working directory; shared references use ./results/db." >&2
            exit 1
            ;;
        -t|--threads)
            require_value "$@"
            THREADS="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'"
            show_help
            exit 1
            ;;
    esac
done

if [[ "$SINGLE_V" == true && "$NOTREE" == true ]]; then
    echo "Error: --singleV and --notree are mutually exclusive" >&2
    exit 1
fi

# Validate thread count is a positive integer
if ! [[ "$THREADS" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --threads must be a positive integer, got '$THREADS'"
    exit 1
fi

# Validate --classifier
case "$DB_TYPE" in
    greengenes|silva) ;;
    *)
        echo "Error: --classifier must be one of: greengenes, silva (got '$DB_TYPE')"
        exit 1
        ;;
esac

# Validate --confidence is a valid float between 0 and 1
if ! [[ "$CONFIDENCE" =~ ^[0-9]*\.?[0-9]+$ ]] || \
   awk "BEGIN{exit !($CONFIDENCE < 0 || $CONFIDENCE > 1)}" 2>/dev/null; then
    echo "Error: --confidence must be a number between 0 and 1, got '$CONFIDENCE'"
    exit 1
fi
# Normalize valid CLI forms such as .7 for the shared JSON parameter snapshot.
CONFIDENCE=$(python3 -c 'import sys; print(float(sys.argv[1]))' "$CONFIDENCE")

# Resolve input before creating outputs or preparing references.
if [[ ! -d "$INPUT_DIR" ]]; then
    if [[ "$INPUT_EXPLICIT" == false ]]; then
        echo "Error: Default input directory '$INPUT_DIR' does not exist." >&2
        echo "Run AmpliconPIP first, or use --input DIR to select existing PIP results." >&2
    else
        echo "Error: Input directory '$INPUT_DIR' does not exist." >&2
        echo "Select a directory containing AmpliconPIP results." >&2
    fi
    exit 1
fi
INPUT_DIR=$(cd "$INPUT_DIR" && pwd)

# Output is fixed beneath the launch directory, even when --input is overridden.
mkdir -p "$OUTPUT"
OUTPUT=$(cd "$OUTPUT" && pwd)

# Collect first so ambiguous methods and missing results fail before downloads.
mkdir -p "${OUTPUT}/.tmpdir"
COLLECTION="${OUTPUT}/.tmpdir/taxa-collection.json"
collect_args=(--input "$INPUT_DIR" --output "$COLLECTION")
[[ -z "$MODE" ]] || collect_args+=(--method "$MODE")
MODE=$(python3 "${SCRIPTS}/taxa_inputs.py" collect "${collect_args[@]}")
REGION="multiV"
[[ "$SINGLE_V" == false ]] || REGION="singleV"
[[ "$NOTREE" == false ]] || REGION="notree"
FINAL_DIR="${OUTPUT}/final-${MODE}-${REGION}"

# Prepare only references required by the selected classifier and tree mode.
# All module invocations use the same startup-working-directory cache.
ORIENT_REF=$(python3 "${SCRIPTS}/reference_resources.py" prepare \
    --kind gg2-sequences --work-dir "$WORK_DIR")
NB_CLASSIFIER=$(python3 "${SCRIPTS}/reference_resources.py" prepare \
    --kind "${DB_TYPE}-classifier" --work-dir "$WORK_DIR")
SEPP_REF=""
if [[ "$SINGLE_V" == false && "$NOTREE" == false ]]; then
    SEPP_REF=$(python3 "${SCRIPTS}/reference_resources.py" prepare \
        --kind sepp --work-dir "$WORK_DIR")
fi
case "$DB_TYPE" in
    greengenes) DB_LABEL="gg2" ;;
    silva) DB_LABEL="silva" ;;
esac

################################################################################
#                    DISPLAY CONFIGURATION                                     #
################################################################################

echo "========================================="
echo "Meta2Data AmpliconTAXA"
echo "========================================="
echo "Method:         $MODE"
echo "Region mode:    $REGION"
echo "Database Dir:   $DB_DIR"
echo "Classifier:     $DB_TYPE ($DB_LABEL)"
echo "  Orient Ref:   $(basename "$ORIENT_REF")  (GG2, always)"
echo "  Classifier:   $(basename "$NB_CLASSIFIER")"
if [[ "$SINGLE_V" == false && "$NOTREE" == false ]]; then
    echo "  SEPP Ref:     $(basename "$SEPP_REF")"
fi
echo "Confidence:     $CONFIDENCE"
echo "Input:          $INPUT_DIR"
echo "Output:         $OUTPUT"
echo "Threads:        $THREADS"
echo "========================================="
echo ""

################################################################################
#                    RUN TAXONOMY PIPELINE                                      #
################################################################################

# Export environment variables for taxonomy.sh
export CONFIDENCE SINGLE_V NOTREE
mkdir -p "$FINAL_DIR"
python3 "${SCRIPTS}/parameters.py" save "${parameter_args[@]}" --output "${FINAL_DIR}/parameters.json"
prepare_args=(--collection "$COLLECTION" --final-dir "$FINAL_DIR"
              --orient-ref "$ORIENT_REF" --classifier "$NB_CLASSIFIER"
              --confidence "$CONFIDENCE" --db-label "$DB_LABEL")
if [[ "$NOTREE" == true ]]; then
    prepare_args+=(--notree)
elif [[ "$SINGLE_V" == true ]]; then
    prepare_args+=(--single-v)
else
    prepare_args+=(--sepp-ref "$SEPP_REF")
fi
python3 "${SCRIPTS}/taxa_inputs.py" prepare "${prepare_args[@]}"
export MODE
export FINAL_DIR
export SCRIPTS
export DB_LABEL
export NB_CLASSIFIER
export ORIENT_REF
export SEPP_REF
export INPUT_DIR
export OUTPUT
export cpu=$THREADS

# Redirect ALL temporary-file paths to the output directory so that the
# pipeline never touches the small /tmp on HPC compute nodes.
PIPELINE_TMPDIR="${OUTPUT}/.tmpdir"
mkdir -p "$PIPELINE_TMPDIR"
export TMPDIR="$PIPELINE_TMPDIR"
export TEMP="$PIPELINE_TMPDIR"
export TMP="$PIPELINE_TMPDIR"
export QIIME2_CACHE="${PIPELINE_TMPDIR}/qiime2-cache"
mkdir -p "$QIIME2_CACHE"
export PYTHONWARNINGS="ignore::FutureWarning"

echo "========================================="
echo "Running Taxonomy & Tree Pipeline"
echo "Started: $(date)"
echo "TMPDIR:         $TMPDIR"
echo "========================================="
echo ""

if ! bash "${SCRIPTS}/taxonomy.sh"; then
    echo "ERROR: Taxonomy pipeline failed"
    echo "Check logs in: $OUTPUT"
    echo "QIIME2 tmpdir preserved for debugging: $PIPELINE_TMPDIR"
    exit 1
fi

echo ""
echo "Taxonomy pipeline completed successfully"
echo ""

################################################################################
#                             Final Summary                                    #
################################################################################

echo "========================================="
echo "AmpliconTAXA COMPLETE"
echo "Finished: $(date)"
echo "========================================="
echo ""
echo "Results saved in: ${FINAL_DIR}/"
echo "========================================="
