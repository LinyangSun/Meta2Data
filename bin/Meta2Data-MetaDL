#!/bin/bash
set -e

# Resolve symlinks before locating sibling commands or packaged scripts.
_M2D_ENTRYPOINT="$(readlink -f -- "${BASH_SOURCE[0]}")" || {
    echo "ERROR: Cannot resolve Meta2Data entry point: ${BASH_SOURCE[0]}" >&2
    exit 1
}
SCRIPT_DIR="$(dirname -- "$(dirname -- "$_M2D_ENTRYPOINT")")"

# Search for scripts directory in multiple possible locations
if [[ -d "${SCRIPT_DIR}/scripts" ]]; then
    SCRIPTS="${SCRIPT_DIR}/scripts"
elif [[ -d "${SCRIPT_DIR}/share/Meta2Data/scripts" ]]; then
    SCRIPTS="${SCRIPT_DIR}/share/Meta2Data/scripts"
elif [[ -d "${HOME}/.local/share/Meta2Data/scripts" ]]; then
    SCRIPTS="${HOME}/.local/share/Meta2Data/scripts"
elif [[ -d "${CONDA_PREFIX}/share/Meta2Data/scripts" ]]; then
    SCRIPTS="${CONDA_PREFIX}/share/Meta2Data/scripts"
else
    echo "ERROR: Scripts directory not found" >&2
    exit 1
fi

show_help() {
    cat <<'EOF'
Usage: Meta2Data MetaDL [options]

Retrieve and merge public project, sample and Run metadata. Choose one mode:

ID-file mode (default):
    -i, --input DIR        Directory containing .txt files, one ID per line.
                          Reads this directory only, without recursing.
                          Supports BioProject, BioSample and SRA accessions,
                          such as PRJNA*, PRJEB*, PRJDB*, PRJCA*, SAMN*, SAMEA*,
                          SAMD*, SRR*, ERR* and DRR*. Invalid IDs are reported.
                          Does not require a keyword search first.

Keyword mode:
    --keywords            Enable keyword search instead of ID-file input.
    --field TERM...       Required research/method terms.
    --organism TERM...    Required organism or subject terms.
    --opt TERM...         Optional additional terms.

Common options:
    -o, --output DIR      Required metadata output directory; created if needed.
                          Independent of PIP/TAXA results/ directories.
    -k, --api-key KEY     Optional NCBI API key.
    -w, --max-workers N   Parallel workers (default: 3 without a key, 8 with one).
    -h, --help            Show this help.

Examples:
    # ID files: save metadata in a new subdirectory of the input folder.
    Meta2Data MetaDL -i id_files -o id_files/metadata

    # Keywords: Bash arrays keep related search terms together.
    bee=("Apis" "Bombus")
    methods=("16S rRNA" "amplicon")
    Meta2Data MetaDL --keywords --field "${methods[@]}" \
        --organism "${bee[@]}" -o metadata/bee

Main outputs in the chosen output directory:
    all_metadata_merged.csv  Merged metadata for review and filtering.
    status.tsv               Per-ID retrieval status.
    column_description.tsv   Column statistics.
    bioproject_absdesc.tsv    Project publication information.
    RecordWithoutRUNinfo.csv Records without Run information, when present.
    searched_keywords/       Search results (keyword mode only).
    tmp/                     Intermediate files and resume checkpoints.

Re-run the same task with the same output directory to resume. Use a separate
output directory for another ID list or keyword search. Select the projects and
Runs needed for analysis before passing their CSV to AmpliconPIP.
EOF
}

INPUT=""
OUTPUT=""
API_KEY=""
MAX_WORKERS=""
KEYWORDS=""
FIELD=()
ORGANISM=()
OPT=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -i|--input)
            INPUT="$2"
            shift 2
            ;;
        -o|--output)
            OUTPUT="$2"
            shift 2
            ;;
        -k|--api-key)
            API_KEY="$2"
            shift 2
            ;;
        -w|--max-workers)
            MAX_WORKERS="$2"
            shift 2
            ;;
        --keywords)
            KEYWORDS="true"
            shift 1
            ;;
        --field)
            shift
            while [[ $# -gt 0 && ! "$1" =~ ^- ]]; do
                FIELD+=("$1")
                shift
            done
            ;;
        --organism)
            shift
            while [[ $# -gt 0 && ! "$1" =~ ^- ]]; do
                ORGANISM+=("$1")
                shift
            done
            ;;
        --opt)
            shift
            while [[ $# -gt 0 && ! "$1" =~ ^- ]]; do
                OPT+=("$1")
                shift
            done
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'"
            show_help
            exit 1
            ;;
    esac
done

INPUT="${INPUT%/}"
OUTPUT="${OUTPUT%/}"

# Validate required parameters
if [[ -z "$OUTPUT" ]]; then
    echo "Error: --output is required"
    show_help
    exit 1
fi

mkdir -p "$OUTPUT"

if [[ "$KEYWORDS" == "true" ]]; then
    # Keywords mode
    if [[ ${#FIELD[@]} -eq 0 || ${#ORGANISM[@]} -eq 0 ]]; then
        echo "Error: --keywords mode requires both --field and --organism"
        show_help
        exit 1
    fi

    # Log parameters
    echo "=== Meta2Data MetaDL V2.1 - KEYWORD SEARCH MODE ==="
    echo "Output directory: $OUTPUT"
    echo "Field terms:      ${FIELD[*]}"
    echo "Organism terms:   ${ORGANISM[*]}"
    if [[ ${#OPT[@]} -gt 0 ]]; then
        echo "Optional terms:   ${OPT[*]}"
    fi
    echo "API key:          $(if [[ -n "$API_KEY" ]]; then echo "Yes"; else echo "No"; fi)"
    if [[ -n "$MAX_WORKERS" ]]; then
        echo "Max workers:      $MAX_WORKERS (custom)"
    fi
    echo "===================================================="
    echo ""

    PYTHON_CMD=(
        python3 "${SCRIPTS}/metadata_downloader.py"
        --output "$OUTPUT"
        --keywords
    )

    PYTHON_CMD+=(--field)
    for term in "${FIELD[@]}"; do
        PYTHON_CMD+=("$term")
    done

    PYTHON_CMD+=(--organism)
    for term in "${ORGANISM[@]}"; do
        PYTHON_CMD+=("$term")
    done

    if [[ ${#OPT[@]} -gt 0 ]]; then
        PYTHON_CMD+=(--opt)
        for term in "${OPT[@]}"; do
            PYTHON_CMD+=("$term")
        done
    fi

else
    # ID input mode
    if [[ -z "$INPUT" ]]; then
        echo "Error: --input is required when not using --keywords mode"
        show_help
        exit 1
    fi

    # Check if input directory exists
    if [[ ! -d "$INPUT" ]]; then
        echo "Error: Input directory '$INPUT' not found"
        exit 1
    fi

    # Check if input directory contains txt files
    txt_count=$(find "$INPUT" -maxdepth 1 -name "*.txt" | wc -l)
    if [[ $txt_count -eq 0 ]]; then
        echo "Error: No .txt files found in input directory '$INPUT'"
        echo "Please provide BioProject or BioSample IDs in .txt files (one ID per line)"
        exit 1
    fi

    # Log parameters
    echo "=== Meta2Data MetaDL V2.1 - ID INPUT MODE ==="
    echo "Input directory:  $INPUT"
    echo "Output directory: $OUTPUT"
    echo "API key:          $(if [[ -n "$API_KEY" ]]; then echo "Yes (parallel: 8 workers)"; else echo "No (parallel: 3 workers)"; fi)"
    if [[ -n "$MAX_WORKERS" ]]; then
        echo "Max workers:      $MAX_WORKERS (custom)"
    fi
    echo "Input ID files:   $txt_count"
    echo "====================================================="
    echo ""

    PYTHON_CMD=(
        python3 "${SCRIPTS}/metadata_downloader.py"
        --input "$INPUT"
        --output "$OUTPUT"
    )
fi

if [[ -n "$API_KEY" ]]; then
    PYTHON_CMD+=(--api-key "$API_KEY")
fi

if [[ -n "$MAX_WORKERS" ]]; then
    PYTHON_CMD+=(--max-workers "$MAX_WORKERS")
fi

# Temporarily disable errexit so a non-zero exit from the pipeline is captured
# in EXIT_CODE (and reported by the failure branch below) instead of aborting
# the wrapper silently.
set +e
"${PYTHON_CMD[@]}"
EXIT_CODE=$?
set -e

if [[ $EXIT_CODE -eq 0 ]]; then
    echo ""
    echo "========================================"
    echo "MetaDL V2.1 completed successfully!"
    echo "========================================"
    echo ""
    echo "Output files are in: $OUTPUT"
    echo ""
    echo "Main output files:"
    echo "  - all_metadata_merged.csv (merged NCBI + CNCB metadata)"
    echo "  - status.tsv              (download status for all input IDs)"
    echo "  - column_description.tsv  (per-column statistics)"
    echo "  - bioproject_absdesc.tsv  (per-BioProject publication info)"
    echo ""
    if [[ "$KEYWORDS" == "true" ]]; then
        echo "Keyword search results:"
        echo "  - searched_keywords/combined_results.csv  (BioProject search results)"
        echo "  - searched_keywords/bioproject_ids.txt    (matched accessions)"
        echo "  - searched_keywords/search_summary.txt    (query summary)"
        echo ""
    fi
    echo "Internal / resume (safe to delete):"
    echo "  - tmp/            (intermediates, raw data, checkpoints)"
    echo ""
else
    echo ""
    echo "========================================"
    echo "MetaDL V2.1 failed with exit code $EXIT_CODE"
    echo "========================================"
    echo ""
    echo "Resume by running the same command again (checkpoints enabled, in $OUTPUT/tmp/checkpoints/)"
    echo ""
    exit $EXIT_CODE
fi
