Bootstrap: docker
From: ubuntu:24.04

# Build the same minimal locked runtime and standalone SRA used by native Conda.
# Example: sudo apptainer build --build-arg SOURCE_DIR=. Meta2Data.sif container/Meta2Data.def
%files
    {{ SOURCE_DIR }}/bin /opt/meta2data-current/bin
    {{ SOURCE_DIR }}/scripts /opt/meta2data-current/scripts
    {{ SOURCE_DIR }}/docs /opt/meta2data-current/docs
    {{ SOURCE_DIR }}/test /opt/meta2data-current/test
    {{ SOURCE_DIR }}/tests /opt/meta2data-current/tests
    {{ SOURCE_DIR }}/example /opt/meta2data-current/example
    {{ SOURCE_DIR }}/README.md /opt/meta2data-current/README.md
    {{ SOURCE_DIR }}/env.yml /opt/meta2data-current/env.yml
    {{ SOURCE_DIR }}/environment-constraints-linux-64.txt /opt/meta2data-current/environment-constraints-linux-64.txt
    {{ SOURCE_DIR }}/environment-linux-64.lock /opt/meta2data-current/environment-linux-64.lock

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl unzip procps
    rm -rf /var/lib/apt/lists/*

    # The installer and its digest are from the named official Miniforge release.
    curl --fail --location --show-error --retry 3 \
        https://github.com/conda-forge/miniforge/releases/download/26.9.4-2/Miniforge3-Linux-x86_64.sh \
        --output /tmp/miniforge.sh
    echo 'bbaf16b3897da24c4be50315934ba74848f617b4495982841d6a0a60e0edbbdf  /tmp/miniforge.sh' | sha256sum --check -
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh
    /opt/conda/bin/python /opt/meta2data-current/scripts/create_conda_environment.py \
        --conda /opt/conda/bin/conda --prefix /opt/conda/envs/meta2data
    export CONDA_PREFIX=/opt/conda/envs/meta2data
    export PATH=/opt/meta2data-current/bin:/opt/conda/envs/meta2data/bin:/opt/conda/bin:$PATH
    /opt/conda/bin/conda list --prefix "$CONDA_PREFIX" --explicit \
        > /opt/meta2data-current/environment-installed-linux-64.txt
    /opt/conda/bin/conda clean --all --yes

    mkdir -p /opt/Meta2Data/reference
    for component in bin scripts docs test tests example README.md env.yml environment-constraints-linux-64.txt environment-linux-64.lock; do
        ln -s "/opt/meta2data-current/$component" "/opt/Meta2Data/$component"
    done
    chmod -R a+rX /opt/meta2data-current
    chmod a+rx /opt/meta2data-current/bin/*
    for command in Meta2Data Meta2Data-MetaDL Meta2Data-AmpliconPIP Meta2Data-AmpliconTAXA; do
        ln -s "/opt/meta2data-current/bin/$command" "/usr/local/bin/$command"
    done

    # Keep the conventional embedded SEPP location and runtime lookup contract.
    PYTHONPATH=/opt/meta2data-current/scripts python -c \
        'from pathlib import Path; from reference_resources import RESOURCES, download, validate_artifact; resource = RESOURCES["sepp"]; target = Path("/opt/Meta2Data/reference") / resource.filename; download(resource.url, target); validate_artifact(target, resource.semantic_type)'
    chmod -R a+rX /opt/Meta2Data/reference
    qiime dev refresh-cache
    find /opt/meta2data-current -type d -name __pycache__ -prune -exec rm -rf {} +

%environment
    export META2DATA_HOME=/opt/meta2data-current
    export META2DATA_SEPP_REF=/opt/Meta2Data/reference/sepp-refs-gg-13-8.qza
    export CONDA_PREFIX=/opt/conda/envs/meta2data
    export PATH=/opt/meta2data-current/bin:/opt/conda/envs/meta2data/bin:/opt/conda/bin:$PATH
    export XDG_CONFIG_HOME="${TMPDIR:-/tmp}/meta2data-config-$(id -u)"
    export XDG_CACHE_HOME="${TMPDIR:-/tmp}/meta2data-cache-$(id -u)"
    export NUMBA_CACHE_DIR="${XDG_CACHE_HOME}/numba"
    export MPLCONFIGDIR="${XDG_CACHE_HOME}/matplotlib"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export MPLBACKEND=agg
    export UNIFRAC_USE_GPU=N
    export PYTHONNOUSERSITE=1

%runscript
    exec /opt/meta2data-current/bin/Meta2Data "$@"

%test
    set -eu
    # Check the installed interfaces here. The workflow has already run native
    # unit/platform tests and will exercise real fixtures in the final SIF.
    validation_dir=$(mktemp -d)
    PYTHONDONTWRITEBYTECODE=1 python \
        /opt/meta2data-current/tests/integration/validate_runtime.py \
        --environment-only --work-dir "$validation_dir"
    rm -rf "$validation_dir"

%labels
    org.opencontainers.image.title Meta2Data
    org.opencontainers.image.description QIIME 2 2026.7 runtime with scikit-learn 1.7.1

%help
    Meta2Data with QIIME 2 2026.7 from the supplied source checkout.
    Run from your analysis working directory.
    Results and references are prepared automatically in ./results/.
    Example: apptainer run Meta2Data.sif AmpliconPIP --help
